# Samsung Auto Trader 환경변수 (선택적 — kis_devlp.yaml로도 설정 가능)
#
# 거래 모드: demo (모의투자, 기본값) | real (실전투자)
KIS_ENV=demo

# 매매 대상 종목코드 (기본값: 005930 삼성전자)
TARGET_STOCK=005930

# 주문 오프셋 (원 단위, 기본값: 1000)
BUY_OFFSET=1000
SELL_OFFSET=1000

# 1회 주문 수량 (기본값: 1)
ORDER_QTY=1

# 실행 방식: false(기본값)=1회 실행 후 종료 | true=POLL_INTERVAL 간격으로 반복 폴링
POLLING_MODE=false

# 폴링 간격 (초, 기본값: 30) — POLLING_MODE=true 일 때만 사용됨
POLL_INTERVAL=30
